# Copy this file to .env, fill it in, then restart: npm start
PORT=3000
# From Google Cloud Console > APIs & Services > Credentials (OAuth client, Web application)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Instagram Business Login app credentials. Requires a Business or Creator account.
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
# Meta app credentials for Facebook Login (identity only; personal-account metrics are not exposed).
META_CLIENT_ID=your-meta-app-id
META_CLIENT_SECRET=your-meta-app-secret
META_GRAPH_API_VERSION=v23.0
# X OAuth 2.0 confidential client credentials. X API access may require an approved/paid plan.
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
# LinkedIn app credentials; enable Sign In with LinkedIn using OpenID Connect (identity only).
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# 64 hex characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your-64-character-hex-key

# Add these callback URLs to each OAuth app (replace host/port if BASE_URL is set):
# http://localhost:3000/api/auth/youtube/callback
# http://localhost:3000/api/auth/instagram/callback
# http://localhost:3000/api/auth/facebook/callback
# http://localhost:3000/api/auth/x/callback
# http://localhost:3000/api/auth/linkedin/callback
